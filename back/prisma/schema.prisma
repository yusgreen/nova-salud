// schema.prisma — contrato de datos de Nova Salud
// Dueño: Angel + Qwen. Marlon y Brat NO editan este archivo sin avisar.
// Version calibrada a Prisma 7.10.1 (estable, sin -rc).

generator client {
  provider = "prisma-client-js"
  // Elegido a proposito: compatible con CommonJS sin config extra.
  // Emite warning de deprecacion en 7.x (esperado, ver seccion 10 de la doc).
}

datasource db {
  provider = "sqlite"          // en dev es un ARCHIVO local; en prod se cambia a "postgresql"
  url      = env("DATABASE_URL") // lee el .env, NUNCA hardcodea la cadena aqui
}

// --- USUARIO: quien opera el sistema (condicion 1 de seguridad del enunciado) ---
model Usuario {
  id           Int      @id @default(autoincrement())
  nombre       String
  email        String   @unique          // @unique = no puede haber dos cuentas con el mismo mail
  passwordHash String                    // bcrypt, NUNCA texto plano. La condicion 1 vive aqui.
  rol          String   @default("cajero") // admin | farmaceutico | cajero
  // Por que String y no enum: SQLite no soporta enums nativos en Prisma.
  // Con String evitamos que db push reviente en la primera creacion de tablas.
  ventas       Venta[]                    // relacion inversa: un usuario tiene muchas ventas
  audits AuditLog[] @relation("AuditUsuario")
}

// --- PRODUCTO: el inventario (hereda el Product del e-commerce + stock) ---
model Producto {
  id               Int             @id @default(autoincrement())
  nombre           String
  descripcion      String
  precio           Float
  imagen           String
  stock            Int             @default(0)
  stockMinimo      Int             @default(0)    // el umbral que dispara la alerta de reposicion
  codigo           String?         @unique         // SKU interno: se autogenera al crear si no se envia
  codigoBarras     String?         @unique
  categoria        String?
  proveedor        String?
  unidad           String          @default("unidad")
  precioCompra     Float?                          // costo para calcular el margen en la UI
  fechaVencimiento DateTime?
  detalles         DetalleVenta[]                 // relacion inversa: un producto aparece en muchos detalles de venta
  movimientos      MovimientoStock[]
}

// --- MOVIMIENTOSTOCK: trazabilidad de entradas/salidas de inventario ---
model MovimientoStock {
  id            Int      @id @default(autoincrement())
  productoId    Int
  producto      Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  usuarioId     Int?
  tipo          String   // INICIAL | AJUSTE | VENTA
  cantidad      Int      // delta: positivo entra, negativo sale
  stockAnterior Int
  stockNuevo    Int
  motivo        String?
  creadoEn      DateTime @default(now())

  @@index([productoId, creadoEn])
}

// --- VENTA: el ticket (el "registro de ventas" del enunciado) ---
model Venta {
  id          Int            @id @default(autoincrement())
  fecha       DateTime       @default(now()) // se llena sola al crear la venta
  total       Float
  usuarioId   Int                            // foreign key: quien atendio
  atendidoPor Usuario        @relation(fields: [usuarioId], references: [id])
  detalles    DetalleVenta[]
  nota String?
}

// --- DETALLEVENTA: cada linea del ticket (producto + cantidad + precio congelado) ---
model DetalleVenta {
  id             Int      @id @default(autoincrement())
  ventaId        Int
  productoId     Int
  cantidad       Int
  precioUnitario Float    // congelado al momento de vender: si manana sube el precio, el historial no miente
  venta          Venta    @relation(fields: [ventaId], references: [id])
  producto       Producto @relation(fields: [productoId], references: [id])
}

// --- CONFIGURACION: ajustes globales de la pagina (fila unica id=1) ---
model Configuracion {
  id              Int      @id @default(1)
  nombreNegocio   String   @default("Nova Salud")
  lema            String   @default("Sistema de inventario y ventas en tiempo real")
  moneda          String   @default("S/")
  umbralStockBajo Int      @default(10)
  mostrarAyudaDemo Boolean @default(true)
  actualizadoEn   DateTime @updatedAt
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      Usuario? @relation("AuditUsuario", fields: [userId], references: [id], onDelete: SetNull)
  accion    String   // LOGIN, LOGIN_FALLIDO, REGISTER, SALE_CREATE, PRODUCT_CREATE, PRODUCT_UPDATE, PRODUCT_DELETE
  entidad   String?  // Usuario, Venta, Producto
  entidadId Int?
  detalle   String?  // JSON serializado como string para evitar dependencias de tipo Json en SQLite
  ip        String?
  userAgent String?
  fecha     DateTime @default(now())

  @@index([fecha])
  @@index([userId])
  @@index([accion])
}